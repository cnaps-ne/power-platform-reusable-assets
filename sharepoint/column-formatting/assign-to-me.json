{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/column-formatting.schema.json",
  "elmType": "button",
  "txtContent": "=if(@currentField.email,@currentField.title,'Assign to me')",
  "attributes": {"class":"ms-fontColor-themePrimary ms-bgColor-neutralLighter--hover","title":"=if(@currentField.email,'Currently assigned','Assign this item to me')"},
  "style": {"border":"none","background-color":"transparent","cursor":"=if(@currentField.email,'default','pointer')","padding":"4px 8px","border-radius":"12px"},
  "customRowAction": {"action":"setValue","actionInput":{"AssignedTo":"@me"}}
}
